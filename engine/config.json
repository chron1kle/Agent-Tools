{
  "version": "1.0",
  "description": "Workflow Engine Configuration",
  "engine": {
    "max_concurrent_workflows": 10,
    "default_timeout": 3600,
    "state_store": "memory"
  },
  "log": {
    "enabled": true,
    "host": "localhost",
    "port": 8766,
    "level": "INFO"
  },
  "task_queue": {
    "max_workers": 3,
    "progress_interval": 1.0,
    "task_timeout": 3600,
    "queue_max_size": 100
  }
}
